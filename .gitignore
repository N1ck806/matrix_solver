# =============================================================================
# MatrixLab — .gitignore
# =============================================================================
# Исключает из репозитория всё, что генерируется автоматически, содержит
# секреты, зависит от локального окружения или относится к инструментам
# разработчика. В репозиторий попадают только исходники проекта.
# =============================================================================


# -----------------------------------------------------------------------------
# Python — байт-код и кэши
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt


# -----------------------------------------------------------------------------
# Виртуальные окружения
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.ENV/
.virtualenv/
.env
.env.*
!.env.example


# -----------------------------------------------------------------------------
# Django — база данных, медиа, статика сборки, миграции
# -----------------------------------------------------------------------------
# Локальная база данных SQLite — не коммитим, у каждого своя.
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal

# Собранная статика (collectstatic)
staticfiles/
media/
mediafiles/

# Файлы, которые создаются при разработке, но не нужны в репозитории
*.log
local_settings.py


# -----------------------------------------------------------------------------
# Тестирование и покрытие
# -----------------------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.pytest_cache/
.cache/
nosetests.xml
nosetests.xml.old
*.cover
*.py,cover


# -----------------------------------------------------------------------------
# Jupyter / IPython (на случай экспериментов с SymPy)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py


# -----------------------------------------------------------------------------
# Типизация и линтеры
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint.d/
.bandit


# -----------------------------------------------------------------------------
# Пакетные менеджеры и сборочные артефакты
# -----------------------------------------------------------------------------
pip-wheel-metadata/
Pipfile.lock
poetry.lock
.uv/
.uv-cache/


# -----------------------------------------------------------------------------
# Редакторы и IDE
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json.example

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*~
.vim/
.nvim/

# Emacs
*~
\#*\#
.\#*


# -----------------------------------------------------------------------------
# Операционные системы
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
.directory
.Trash-*
.nfs*


# -----------------------------------------------------------------------------
# Прочее
# -----------------------------------------------------------------------------
# Локальные экспорты и дампы
*.tmp
*.bak
*.backup
*.orig

# Секреты и ключи (никогда в репозиторий)
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json